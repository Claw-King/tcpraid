# systemd unit for a tcpraid node. Put the binary at /usr/local/bin/tcpraid and make the
# user the node runs as, once:
#
#   useradd --system --user-group --no-create-home --shell /usr/sbin/nologin tcpraid
#
# The node keeps its identity key, peers and rules in /var/lib/tcpraid. systemd creates
# that directory and gives it to the user tcpraid. A directory that an earlier unit ran
# as root in is handed over the same way at the next start, with everything in it.
#
# The web interface and the local API are at 127.0.0.1:9850; the password of the web
# interface is printed once in the log at the first start (journalctl -u tcpraid-node).
# To reach the web interface from other hosts, add "-api ADDRESS:9850" below. Leave
# out "-listen" on a node that other nodes cannot reach anyway.
#
# A file that the command line names (-cert, -key, -ui-password-file) must be readable
# by the user tcpraid.
[Unit]
Description=tcpraid node (one TCP connection carried over several)
After=network-online.target
Wants=network-online.target

[Service]
User=tcpraid
Group=tcpraid
ExecStart=/usr/local/bin/tcpraid run -data /var/lib/tcpraid -listen 0.0.0.0:9851
StateDirectory=tcpraid
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=2

# The node needs no privilege for the command line above, for forwarding rules on ports
# from 1024 up, or for transparent rules (the host's redirect rule is the host's own;
# the node only listens where the rule sends the connections).
#
# A port below 1024, for -listen, -api or the listen address of a rule, needs one
# capability. Put a "#" before the two lines below and take it away from the two lines
# that follow them.
CapabilityBoundingSet=
AmbientCapabilities=
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE

# What the node does not need is taken away from it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
