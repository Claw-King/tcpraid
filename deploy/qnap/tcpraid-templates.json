{
  "templates": [
    {
      "type": 1,
      "title": "tcpraid",
      "sub_title": "0.1.1",
      "description": "Carries one TCP connection over several TCP connections at once, for software that opens a single stream. Web interface on port 9850; with an empty TCPRAID_UI_PASSWORD the node makes a password at its first start and prints it once in its log.",
      "location": "https://github.com/Claw-King/tcpraid",
      "platform": "linux/amd64",
      "image": "ghcr.io/claw-king/tcpraid:0.1.1",
      "env": [
        {
          "name": "TCPRAID_UI_PASSWORD",
          "value": ""
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "volume": "tcpraid-data"
        }
      ],
      "ports": [
        "9850:9850/tcp",
        "9851:9851/tcp",
        "50000:50000/tcp",
        "50001:50001/tcp",
        "50002:50002/tcp",
        "50003:50003/tcp",
        "50004:50004/tcp",
        "50005:50005/tcp",
        "50006:50006/tcp",
        "50007:50007/tcp",
        "50008:50008/tcp",
        "50009:50009/tcp",
        "50010:50010/tcp"
      ],
      "hostname": "tcpraid",
      "restart_policy": "unless-stopped",
      "interactive": false,
      "tty": false,
      "privileged": false
    },
